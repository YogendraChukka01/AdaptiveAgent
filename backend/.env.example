# ─────────────────────────────────────────────────────────────────────────────
# AdaptiveAgent — Environment Configuration Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # Set to "production" to enable strict security checks
DEBUG=false
LOG_LEVEL=INFO

# ── API Authentication ────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 32
API_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://safeagent:CHANGE_ME@localhost:5432/safeagent
DATABASE_URL_SYNC=postgresql://safeagent:CHANGE_ME@localhost:5432/safeagent

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# ── Cloud LLM Fallback (optional) ─────────────────────────────────────────────
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_FALLBACK_API_KEY=sk-...

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_PROVIDER=bge

# ── Vector Store ──────────────────────────────────────────────────────────────
# Options: chroma, pgvector, qdrant, pinecone
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_COLLECTION=safeagent_docs
CHROMA_PERSIST_DIRECTORY=./chroma_data

# pgvector (if VECTOR_STORE_TYPE=pgvector):
# PGVECTOR_CONNECTION_STRING=postgresql://safeagent:CHANGE_ME@localhost:5432/safeagent

# Qdrant (if VECTOR_STORE_TYPE=qdrant):
# QDRANT_URL=http://localhost:6333

# Pinecone (if VECTOR_STORE_TYPE=pinecone):
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=

# ── Web Search ────────────────────────────────────────────────────────────────
# Options: none, tavily, serpapi, brave
# Install the matching extra: pip install ".[tavily]" or ".[brave]"
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# ── Evaluation ────────────────────────────────────────────────────────────────
EVAL_ENABLED=true
# 0.70 works for heuristic-only scoring.
# Raise to 0.85 when EVAL_JUDGE_MODEL is set.
EVAL_THRESHOLD=0.70
# Optional: enable LLM-as-judge (uses main LLM if not set separately)
# EVAL_JUDGE_MODEL=gpt-4o-mini
# EVAL_JUDGE_API_KEY=
EVAL_RAGAS_ENABLED=true
EVAL_RELEVANCY_ENABLED=true

# ── Agent Behaviour ───────────────────────────────────────────────────────────
MAX_STEPS=10
CONFIDENCE_RETRY_THRESHOLD=30.0
EVIDENCE_THRESHOLD=0.3
EVIDENCE_MIN_COVERAGE=0.5
HIGH_RISK_THRESHOLD=70.0

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# ── Memory Distillation ───────────────────────────────────────────────────────
MEMORY_DISTILL_ENABLED=true
MEMORY_DISTILL_INTERVAL_MINUTES=30
MEMORY_DISTILL_MAX_MESSAGES=200

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── LangSmith Tracing (optional) ─────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=adaptiveagent
